/*
 * TEMPLATE - copy to secrets.h and fill in the real values.
 *
 *     cp secrets.h.example secrets.h
 *
 * secrets.h is gitignored; THIS file is tracked, so a fresh clone can see what
 * needs providing without the credentials ever entering the repository.
 *
 * Omit the file entirely and the build falls back to the anonymous public
 * broker in app_config.h - it compiles and runs, it just cannot authenticate.
 */
#ifndef SECRETS_H
#define SECRETS_H

/* Broker address. May be a hostname or a bare IP. A bare IP skips DNS, which
 * also removes the "+QMTOPEN: 0,4" (DNS failure) failure mode. */
#define MQTT_HOST      "mqtt.example.com"

/* Leave BOTH empty for an anonymous broker. If MQTT_USERNAME is empty the
 * firmware issues the 2-argument AT+QMTCONN and sends no credentials at all. */
#define MQTT_USERNAME  ""
#define MQTT_PASSWORD  ""

/*
 * Cellular APN for the SIM fitted to this gateway.
 *
 * Without it the modem never attaches - AT+QICSGP is issued with an empty
 * context, PDP activation fails, and MQTT never gets a carrier. There is no
 * sensible default because it is carrier-specific.
 *
 * Common Indian M2M values: "airtelgprs.com", "www" (Vi), "jionet",
 * "bsnlnet". An eSIM profile normally carries its own - ask the provider
 * rather than guessing, since a wrong APN fails the same way an empty one does.
 */
#define CELL_APN       "airtelgprs.com"

#endif /* SECRETS_H */
