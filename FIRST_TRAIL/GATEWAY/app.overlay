/*
 * Gateway UART/I2C/GPIO map — MATCHED TO main_node_schematic_nrf54l15.
 *
 *   Console (debug hdr D_TX/D_RX) : uart20  TX=P1.02(NFC1)  RX=P1.03(NFC2)
 *   LC29H GNSS (UART_x_LC)        : uart30  RX=P0.00        TX=P0.06
 *   EC200 modem (UART_RX/UART_TX) : uart22  RX=P1.06        TX=P1.07
 *   BMA400 + SHT40 (I2C)          : i2c21   SDA=P1.04       SCL=P1.05
 *   BMA400 INT                    : P1.16
 *
 * NOTE: P1.02/P1.03 are the NFC pins. To use them as the console UART the NFC
 * function must be released. On the nRF54L15 that is the &uicr property below,
 * NOT the nRF52/nRF53-only CONFIG_NFCT_PINS_AS_GPIOS Kconfig.
 * On the DK this repins the console off VCOM; that's correct for the custom
 * board. For DK bench testing you may prefer to leave the console at its
 * board default and only keep the GNSS/EC200/I2C/BMA changes below.
 */

/* Release P1.02/P1.03 from the NFC antenna function so uart20 can drive the
 * D_TX/D_RX debug header. Required on the QFN52 gateway board. */
&uicr {
	nfct-pins-as-gpios;
};

/*
 * Internal watchdog. The gateway board has NO external watchdog (the sub-nodes
 * have a TPL5010), so WDT31 is the only hang recovery available. It is
 * status = "disabled" in the SoC devicetree, so it must be enabled here or
 * DEVICE_DT_GET(DT_ALIAS(watchdog0)) fails to link. See src/watchdog.c.
 */
&wdt31 {
	status = "okay";
};

/ {
	/*
	 * NOTE: there is deliberately no "nordic,pm-ext-flash" chosen node here.
	 * It only takes effect with CONFIG_PARTITION_MANAGER_ENABLED, which this
	 * build does not use (it partitions from devicetree), so it was inert.
	 * Its purpose was to place MCUboot's secondary slot on the external NOR
	 * for sub-node image staging - a feature that has been removed.
	 */

	aliases {
		/* Point at the CHILD key (it carries the gpios property), not the
		 * gpio-keys parent, so GPIO_DT_SPEC_GET(DT_ALIAS(bma_int), gpios) works. */
		bma-int = &bma_int;
	};

	bma_int_node: bma-int-node {
		compatible = "gpio-keys";     /* gives us a gpios phandle */
		bma_int: bma_int {
			gpios = <&gpio1 16 (GPIO_ACTIVE_HIGH)>;  /* BMA_INT = P1.16 */
			label = "BMA400 INT";
		};
	};
};

&pinctrl {
	/* Console on the debug header (D_TX/D_RX = P1.02/P1.03) */
	uart20_default: uart20_default {
		group1 { psels = <NRF_PSEL(UART_TX, 1, 2)>, <NRF_PSEL(UART_RX, 1, 3)>; };
	};
	uart20_sleep: uart20_sleep {
		group1 { psels = <NRF_PSEL(UART_TX, 1, 2)>, <NRF_PSEL(UART_RX, 1, 3)>;
			 low-power-enable; };
	};

	/*
	 * LC29H GNSS: our TX=P0.00, our RX=P0.06.
	 *
	 * Same reversal as the modem below, and the same cause - this overlay
	 * overrode the corrected board pinctrl. The schematic nets are named from
	 * the MODULE's side: UART_TX_LC carries the LC29H's TRANSMITTER (module
	 * pin 20) to nRF pin 24 = P0.06, so P0.06 is OUR receiver.
	 */
	uart30_default: uart30_default {
		group1 { psels = <NRF_PSEL(UART_TX, 0, 0)>, <NRF_PSEL(UART_RX, 0, 6)>; };
	};
	uart30_sleep: uart30_sleep {
		group1 { psels = <NRF_PSEL(UART_TX, 0, 0)>, <NRF_PSEL(UART_RX, 0, 6)>;
			 low-power-enable; };
	};

	/*
	 * EC200 modem: our TX=P1.06, our RX=P1.07.
	 *
	 * THIS OVERLAY WAS THE BUG. sw_gateway-pinctrl.dtsi was corrected to this
	 * mapping, and all_hw_test - which defines no uart22 pinctrl of its own -
	 * picked the fix up and started talking to the modem immediately. This
	 * file redefines the same pinctrl nodes and therefore OVERRODE that
	 * correction, so the application kept the original reversed pins.
	 *
	 * Per the netlist: EC200U MAIN_TXD (module pin 67, an OUTPUT) reaches nRF
	 * pin 9 = P1.07 through the TXS0102, so P1.07 must be OUR RX. With TX on
	 * P1.07 the gateway drove an output against the module's output and
	 * listened on the module's RXD input, so nothing could ever arrive -
	 * exactly what every log showed: commands sent, the NETLIGHT reacting to
	 * PWRKEY (a plain GPIO, unaffected by this), and not one byte received.
	 */
	uart22_default: uart22_default {
		group1 { psels = <NRF_PSEL(UART_TX, 1, 6)>, <NRF_PSEL(UART_RX, 1, 7)>; };
	};
	uart22_sleep: uart22_sleep {
		group1 { psels = <NRF_PSEL(UART_TX, 1, 6)>, <NRF_PSEL(UART_RX, 1, 7)>;
			 low-power-enable; };
	};

	/* BMA400 + SHT40 shared I2C: SDA=P1.04, SCL=P1.05 */
	i2c21_default: i2c21_default {
		group1 { psels = <NRF_PSEL(TWIM_SDA, 1, 4)>, <NRF_PSEL(TWIM_SCL, 1, 5)>;
			 bias-pull-up; };
	};
	i2c21_sleep: i2c21_sleep {
		group1 { psels = <NRF_PSEL(TWIM_SDA, 1, 4)>, <NRF_PSEL(TWIM_SCL, 1, 5)>;
			 low-power-enable; };
	};
};

/* console (repinned to the debug header) */
&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* GNSS */
&uart30 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart30_default>;
	pinctrl-1 = <&uart30_sleep>;
	pinctrl-names = "default", "sleep";
};

/* EC200 modem */
&uart22 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart22_default>;
	pinctrl-1 = <&uart22_sleep>;
	pinctrl-names = "default", "sleep";
};

/* sensors I2C */
&i2c21 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Memory SPI bus (P2 high-speed SPIM): NOR (W25Q128) + FRAM.
 *   SCK=P2.01  MOSI=P2.02  MISO=P2.04   NOR_CS=P2.03  FRAM_CS=P2.05
 * NOTE: verify the SPIM node label (spi00) and the jedec-id/FRAM part for your
 * build. The NOR now carries a single 15 MB "archive" partition; the separate
 * ota_stage partition went away with sub-node firmware update.
 */
&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};
	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};
};

&spi00 {
	status = "okay";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>,   /* NOR_CS  (P2.03) */
		   <&gpio2 5 GPIO_ACTIVE_LOW>;   /* FRAM_CS (P2.05) */

	nor: w25q128@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [ef 40 18];           /* W25Q128JV */
		size = <0x8000000>;              /* 128 Mbit (bits) */
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd  = <3000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			/*
			 * W25Q128 (jedec-id ef 40 18), 128 Mbit = 16 MB:
			 *
			 *   0x000000   1.0 MB  reserved (head kept clear)
			 *   0x100000  14.5 MB  archive   - store-and-forward
			 *   0xF80000   0.5 MB  ota_stage - ONE sub-node image
			 *
			 * THESE MUST MATCH pm_static.yml EXACTLY. They previously did
			 * not: this file gave the archive 15 MB running to the end of
			 * the chip, while PM placed a 1 MB ota_partition at 0xF00000 -
			 * INSIDE that range. The store-and-forward ring would have
			 * overwritten a staged firmware image.
			 *
			 * 0.5 MB is sized on the real signed sub-node image
			 * (193,712 B). Only ONE is ever staged: NODE_ID is
			 * compile-time, so every node has a different image and they
			 * are delivered one at a time regardless.
			 *
			 * Archive capacity: records span 1 KB SLOTS (storage.c) and a
			 * heartbeat is ~1.7 KB = 2 slots, so 14.5 MB holds ~7400
			 * heartbeats - about 51 days at the 10-minute moving cadence,
			 * comfortably past the 30-day requirement. (An older comment
			 * here said "4 KB per record", which the code has never done;
			 * that figure made the archive look half its real depth.)
			 *
			 * RESIZING THIS LATER DISCARDS THE BACKLOG. The ring's
			 * head/tail are SLOT NUMBERS held in FRAM, and slot count is
			 * derived from this partition size. Change the size and the
			 * two disagree, so storage_init() detects it (head/tail >=
			 * num_slots) and resets the ring to empty. It cannot corrupt
			 * or crash - but any telemetry still queued for upload on that
			 * gateway is lost on the next boot. Safe to change now; costly
			 * once units are deployed offline.
			 */
			archive_partition: partition@100000 {
				label = "archive";
				reg = <0x100000 0xE80000>;
			};

			/* Staging area for ONE sub-node firmware image: the gateway
			 * downloads it over HTTP, then relays it to the target node
			 * over the authenticated BLE downlink. Erased after delivery
			 * so the next node's image can be staged. */
			ota_partition: partition@f80000 {
				label = "ota_stage";
				reg = <0xF80000 0x80000>;
			};
		};
	};

	fram: fram@1 {
		compatible = "atmel,at25";       /* generic SPI FRAM/EEPROM */
		reg = <1>;
		spi-max-frequency = <8000000>;
		size = <0x80000>;                /* 512 KB (bytes) */
		pagesize = <0x80000>;            /* FRAM: no page-write limit */
		address-width = <24>;
		timeout = <1>;
	};
};
