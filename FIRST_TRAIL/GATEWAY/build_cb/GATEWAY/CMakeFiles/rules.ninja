rule RERUN_CMAKE
  command = C:\ncs\toolchains\dcbdc366a1\opt\bin\cmake.exe --regenerate-during-build -SD:\Z_CONTROLLER_DATA\7.NRF54L15\FIRST_TRIAL\GATEWAY -BD:\Z_CONTROLLER_DATA\7.NRF54L15\FIRST_TRIAL\GATEWAY\build_cb\GATEWAY
  description = Re-running CMake...
